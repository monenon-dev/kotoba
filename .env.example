# docker compose 가 읽는 환경변수 예시. 같은 폴더에 .env 로 복사해서 값을 바꾼다. .env 는 커밋하지 않는다.
DB_NAME=kotoba
DB_USERNAME=kotoba
# DB 를 처음 만들 때만 적용된다. 나중에 바꾸려면 DB 안에서 ALTER USER 도 함께 실행해야 한다.
DB_PASSWORD=change-me
# 32바이트 이상의 무작위 문자열. 예: openssl rand -base64 48
# 아래 예시 값은 일부러 짧게 두었다. 바꾸지 않으면 앱이 기동되지 않는다.
JWT_SECRET=change-me

# 이미지 태그. 기본값은 local. 예: git rev-parse --short HEAD 의 결과
# IMAGE_TAG=local

# Compose 없이 prod 프로필로 실행할 때만 필요하다. (Compose 는 위 값으로 직접 만든다)
# SPRING_PROFILES_ACTIVE=prod
# DB_URL=jdbc:postgresql://<host>:5432/kotoba
